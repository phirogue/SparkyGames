# OS
Thumbs.db
Desktop.ini
.DS_Store

# Editors
.vscode/
.idea/

# Secrets & signing — never commit these
*.keystore
*.jks
*.p12
*.mobileprovision
*.pem
key.properties
google-services.json
GoogleService-Info.plist
.env
.env.*

# Build output
build/
dist/
export/
*.apk
*.aab
*.ipa

# Godot: the import cache is regenerated by `godot --headless --path game --import`
.godot/
*.translation

# Python tooling
__pycache__/
*.pyc
.venv/

# GENERATED — never hand-edit, never commit (regenerate with the named command)
#   play/apps/*.cmd   <- play/play.ps1 -Install   (source: play/parts.json)
play/apps/*.cmd

# GENERATED — the screenshot tour's output (owner decision 2026-08-06).
#   `godot --path game -- --tour` and `python tools/tour_all.py` rewrite every
#   shot on every run, so committing them added ~200 MB of new blobs per tour
#   commit — 903 MB of the repo's 1.42 GB history, for images the tour
#   regenerates on demand.
#
#   Laws 1 and 17 are UNCHANGED: you still run the sweep and read the shots
#   before calling visual work done. What changed is that the reading happens
#   on fresh output rather than on a commit.
#
#   The exception is screenshots/reference/ — a small curated set, tracked on
#   purpose, that says "this is what correct looks like" so a regression has
#   something to be diffed against.
screenshots/*
!screenshots/reference/
!screenshots/README.md
